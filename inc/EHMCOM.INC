C=====================================================================
C     EHMCOM   BLANK AND LABELLED COMMON FOR THE EHMS SUITE
C              INCLUDE AFTER EHMPRM - THE TABLE LIMITS ARE REQUIRED
C
C     CHARACTER AND NUMERIC DATA ARE HELD IN SEPARATE COMMON BLOCKS
C     AS REQUIRED BY THE STANDARD.  NO PROGRAM MAY EXTEND A BLOCK
C     WITHOUT UPDATING THIS DECK AND RECOMPILING THE WHOLE SUITE.
C=====================================================================
C
C     ---- ENGINE MASTER TABLE - CHARACTER PART -----------------------
      CHARACTER*8 CESN
      CHARACTER*4 CFAM, CLOCN, CTHR
      CHARACTER*2 COPR
      CHARACTER*6 CTAIL, CBLD
      COMMON /ENGCHR/ CESN(MAXENG), CFAM(MAXENG), COPR(MAXENG),
     +                CTAIL(MAXENG), CBLD(MAXENG), CLOCN(MAXENG),
     +                CTHR(MAXENG)
C
C     ---- ENGINE MASTER TABLE - NUMERIC PART -------------------------
C     NENG    NUMBER OF ENGINES LOADED
C     IPOSN   INSTALLED POSITION 1-4, ZERO WHEN OFF WING
C     ISTG    LIFE STAGE 1=NEW 2=MATURE 3=PRE SV 4=IN SHOP 5=POST OHL
C     ITFC    TOTAL FLIGHT CYCLES SINCE NEW
C     ICSO    CYCLES SINCE OVERHAUL
C     IENVS   ENVIRONMENT SEVERITY 1 BENIGN TO 5 HARSH
C     TFH     TOTAL FLIGHT HOURS SINCE NEW
C     HSO     HOURS SINCE OVERHAUL
C     EGTM    EGT MARGIN DEG C - THE HEADLINE HEALTH PARAMETER
C     HSCOR   FLEET RELATIVE HEALTH SCORE 0 TO 100
C     IRUL    PROJECTED CYCLES TO REMOVAL
C     ISTAT   ROLL UP STATUS CODE, SEE EHMPRM
      INTEGER NENG, IPOSN, ISTG, ITFC, ICSO, IENVS, IRUL, ISTAT
      REAL    TFH, HSO, EGTM, HSCOR
      COMMON /ENGNUM/ NENG, IPOSN(MAXENG), ISTG(MAXENG),
     +                ITFC(MAXENG), ICSO(MAXENG), IENVS(MAXENG),
     +                IRUL(MAXENG), ISTAT(MAXENG),
     +                TFH(MAXENG), HSO(MAXENG), EGTM(MAXENG),
     +                HSCOR(MAXENG)
C
C     ---- PARAMETER LIMIT TABLE (FROM PARLIM) ------------------------
C     NPRM    NUMBER OF LIMIT CARDS READ
C     CPRM    PARAMETER MNEMONIC          E.G. EGTM
C     CPUNI   ENGINEERING UNIT            E.G. DEGC
C     CPATA   ATA CHAPTER REFERENCE
C     PAMB    AMBER LIMIT
C     PRED    RED LIMIT
C     IPSNS   SENSE, KHIBAD OR KLOBAD
      INTEGER NPRM, IPSNS
      REAL    PAMB, PRED
      CHARACTER*4 CPRM, CPUNI
      CHARACTER*6 CPATA
      COMMON /LIMCHR/ CPRM(MAXPRM), CPUNI(MAXPRM), CPATA(MAXPRM)
      COMMON /LIMNUM/ NPRM, IPSNS(MAXPRM), PAMB(MAXPRM), PRED(MAXPRM)
C
C     ---- TREND TABLE - ONE ENTRY PER ENGINE -------------------------
C     TSLOPE  LEAST SQUARES SLOPE OF EGT MARGIN, DEG C PER CYCLE
C     TINTC   INTERCEPT AT FIRST CYCLE OF THE WINDOW
C     TRSQ    COEFFICIENT OF DETERMINATION
C     TVBMX   PEAK BROADBAND VIBRATION IN THE WINDOW
C     TOILC   MEAN OIL CONSUMPTION LITRES PER HOUR
C     TDEBR   MEAN DEBRIS PARTICLE COUNT
C     TSFCD   SPECIFIC FUEL CONSUMPTION DEVIATION PER CENT
C     NTOBS   NUMBER OF OBSERVATIONS IN THE TREND WINDOW
      INTEGER NTOBS
      REAL    TSLOPE, TINTC, TRSQ, TVBMX, TOILC, TDEBR, TSFCD
      COMMON /TRNNUM/ NTOBS(MAXENG), TSLOPE(MAXENG), TINTC(MAXENG),
     +                TRSQ(MAXENG), TVBMX(MAXENG), TOILC(MAXENG),
     +                TDEBR(MAXENG), TSFCD(MAXENG)
C
C     ---- ALERT TABLE ------------------------------------------------
C     NALR    NUMBER OF ALERTS RAISED THIS RUN
C     IAENG   INDEX INTO THE ENGINE MASTER TABLE
C     IASEV   SEVERITY 1 CRITICAL 2 HIGH 3 MEDIUM 4 LOW 5 INFO
C     IASRC   SOURCE 1 EHM 2 ACARS 3 VIBRATION 4 OIL DEBRIS 5 TREND
C     IADAT   JULIAN DATE OF RAISE, FORM YYDDD
C     AVAL    OBSERVED VALUE
C     ALIM    LIMIT BREACHED
C     CAPRM   PARAMETER MNEMONIC
C     CATXT   NARRATIVE FOR THE CONTROLLER
      INTEGER NALR, IAENG, IASEV, IASRC, IADAT
      REAL    AVAL, ALIM
      CHARACTER*4  CAPRM
      CHARACTER*44 CATXT
      COMMON /ALRCHR/ CAPRM(MAXALR), CATXT(MAXALR)
      COMMON /ALRNUM/ NALR, IAENG(MAXALR), IASEV(MAXALR),
     +                IASRC(MAXALR), IADAT(MAXALR),
     +                AVAL(MAXALR), ALIM(MAXALR)
C
C     ---- RUN CONTROL (SET BY THE CONTROL CARD READER) ---------------
C     JRUNDT  RUN DATE, FORM YYDDD
C     JWINDW  TREND WINDOW IN FLIGHT CYCLES
C     JSEED   PSEUDO RANDOM SEED FOR THE FLEET GENERATOR
C     CRUNID  RUN IDENTIFIER PRINTED ON EVERY PAGE HEADING
      INTEGER JRUNDT, JWINDW, JSEED
      CHARACTER*8 CRUNID
      COMMON /RUNCHR/ CRUNID
      COMMON /RUNNUM/ JRUNDT, JWINDW, JSEED
C=====================================================================
