C=====================================================================
C     EHMPRM   INSTALLATION PARAMETERS AND LOGICAL UNIT ASSIGNMENTS
C              ENGINE HEALTH MONITORING SYSTEM (EHMS)  REL 4.2
C              ROLLS-ROYCE PLC  -  DERBY  -  CIVIL AERO SUPPORT
C
C     THIS DECK IS INCLUDED BY EVERY PROGRAM AND SUBPROGRAM IN THE
C     SUITE.  IT MUST BE THE FIRST DECK INCLUDED.  DO NOT ALTER THE
C     TABLE LIMITS WITHOUT RE-GENERATING THE MASTER FILES.
C=====================================================================
C
C     ---- TABLE LIMITS (CORE RESIDENT) -------------------------------
      INTEGER MAXENG, MAXFLT, MAXALR, MAXSLT, MAXPRM, MAXMOD
      PARAMETER (MAXENG = 240)
      PARAMETER (MAXFLT = 24000)
      PARAMETER (MAXALR = 2000)
      PARAMETER (MAXSLT = 60)
      PARAMETER (MAXPRM = 12)
      PARAMETER (MAXMOD = 11)
C
C     ---- NUMBER OF NUMERIC FIELDS ON A DOWNLINK FLIGHT RECORD -----
      INTEGER NFVAL
      PARAMETER (NFVAL = 18)
C
C     ---- LOGICAL UNIT NUMBERS ---------------------------------------
C     LUCRD  CONTROL CARD READER          (SYSIN)
C     LUPRT  LINE PRINTER 132 COLUMN      (SYSPRINT)
C     LUENG  ENGINE MASTER FILE           ENGMAS
C     LUFLT  FLIGHT / DOWNLINK LOG        FLTLOG
C     LUVAL  VALIDATED DOWNLINK LOG       FLTVAL
C     LULIM  PARAMETER LIMIT FILE         PARLIM
C     LUSLT  SHOP SLOT CAPACITY FILE      SHPSLT
C     LUTRN  TREND MASTER FILE            TRNMAS
C     LUALR  ALERT MASTER FILE            ALRTMS
C     LURUL  LIFE PROJECTION FILE         RULMAS
C     LUPLN  SHOP VISIT PLAN FILE         SVPLAN
C     LUERR  ERROR / REJECT FILE          SYSERR
      INTEGER LUCRD, LUPRT, LUENG, LUFLT, LULIM, LUSLT, LUVAL
      INTEGER LUTRN, LUALR, LURUL, LUPLN, LUERR
      PARAMETER (LUCRD = 5, LUPRT = 6)
      PARAMETER (LUENG = 11, LUFLT = 12, LULIM = 13, LUSLT = 14)
      PARAMETER (LUVAL = 15)
      PARAMETER (LUTRN = 21, LUALR = 22, LURUL = 23, LUPLN = 24)
      PARAMETER (LUERR = 31)
C
C     ---- STATUS CODES (RED/AMBER/GREEN/NO DATA) ---------------------
      INTEGER KGREY, KGREEN, KAMBER, KRED
      PARAMETER (KGREY = 0, KGREEN = 1, KAMBER = 2, KRED = 3)
C
C     ---- SENSE OF A PARAMETER LIMIT ---------------------------------
C     KHIBAD  EXCEEDANCE WHEN VALUE RISES  (VIBRATION, DEBRIS)
C     KLOBAD  EXCEEDANCE WHEN VALUE FALLS  (EGT MARGIN, OIL PRESS)
      INTEGER KHIBAD, KLOBAD
      PARAMETER (KHIBAD = 1, KLOBAD = 2)
C
C     ---- FILE STATUS RETURN CODES -----------------------------------
      INTEGER KOK, KEOF, KBAD
      PARAMETER (KOK = 0, KEOF = 1, KBAD = 2)
C
C     ---- LINES PER PRINTED PAGE -------------------------------------
      INTEGER MAXLIN
      PARAMETER (MAXLIN = 58)
C=====================================================================
