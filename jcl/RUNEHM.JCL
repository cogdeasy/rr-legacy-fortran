//RREHMS   JOB (CAS0442,DERBY),'EHM NIGHTLY RUN',CLASS=B,
//             MSGCLASS=X,NOTIFY=&SYSUID,REGION=4096K
//*
//*=================================================================
//*  ENGINE HEALTH MONITORING SYSTEM - REL 4.2
//*  NIGHTLY JOB STREAM.  SUBMITTED BY THE OPERATIONS SHIFT AT 0130
//*  AFTER THE ACARS GATEWAY TAPE HAS BEEN CATALOGUED.
//*
//*  RESTART.  ANY STEP MAY BE RESTARTED PROVIDED THE PRECEDING
//*  MASTER FILES ARE INTACT.  RESTART AT STEP 030 AFTER A GATEWAY
//*  FAILURE; RESTART AT STEP 010 ONLY UNDER CHANGE CONTROL.
//*=================================================================
//*
//STEP010  EXEC PGM=EHMGEN,REGION=4096K
//STEPLIB  DD DSN=RR.CAS.EHMS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSERR   DD DSN=RR.CAS.EHMS.SYSERR(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(5,5),RLSE)
//ENGMAS   DD DSN=RR.CAS.EHMS.ENGMAS(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=8000)
//FLTLOG   DD DSN=RR.CAS.EHMS.FLTLOG(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=133,BLKSIZE=13300)
//SYSIN    DD DSN=RR.CAS.EHMS.CNTLLIB(EHMCTL),DISP=SHR
//*
//STEP020  EXEC PGM=EHMLOD,COND=(0,LT)
//STEPLIB  DD DSN=RR.CAS.EHMS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSERR   DD DSN=RR.CAS.EHMS.SYSERR(+1),DISP=SHR
//ENGMAS   DD DSN=RR.CAS.EHMS.ENGMAS(0),DISP=SHR
//FLTLOG   DD DSN=RR.CAS.EHMS.FLTLOG(0),DISP=SHR
//PARLIM   DD DSN=RR.CAS.EHMS.CNTLLIB(PARLIM),DISP=SHR
//FLTVAL   DD DSN=RR.CAS.EHMS.FLTVAL(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(20,10),RLSE),
//            DCB=(RECFM=FB,LRECL=133,BLKSIZE=13300)
//SYSIN    DD DSN=RR.CAS.EHMS.CNTLLIB(EHMCTL),DISP=SHR
//*
//STEP030  EXEC PGM=EHMTRN,COND=(0,LT)
//STEPLIB  DD DSN=RR.CAS.EHMS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSERR   DD DSN=RR.CAS.EHMS.SYSERR(+1),DISP=SHR
//ENGMAS   DD DSN=RR.CAS.EHMS.ENGMAS(0),DISP=SHR
//FLTVAL   DD DSN=RR.CAS.EHMS.FLTVAL(0),DISP=SHR
//TRNMAS   DD DSN=RR.CAS.EHMS.TRNMAS(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=8000)
//SYSIN    DD DSN=RR.CAS.EHMS.CNTLLIB(EHMCTL),DISP=SHR
//*
//STEP040  EXEC PGM=EHMALR,COND=(0,LT)
//STEPLIB  DD DSN=RR.CAS.EHMS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSERR   DD DSN=RR.CAS.EHMS.SYSERR(+1),DISP=SHR
//ENGMAS   DD DSN=RR.CAS.EHMS.ENGMAS(0),DISP=SHR
//FLTVAL   DD DSN=RR.CAS.EHMS.FLTVAL(0),DISP=SHR
//TRNMAS   DD DSN=RR.CAS.EHMS.TRNMAS(0),DISP=SHR
//PARLIM   DD DSN=RR.CAS.EHMS.CNTLLIB(PARLIM),DISP=SHR
//ALRTMS   DD DSN=RR.CAS.EHMS.ALRTMS(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=8000)
//SYSIN    DD DSN=RR.CAS.EHMS.CNTLLIB(EHMCTL),DISP=SHR
//*
//STEP050  EXEC PGM=EHMRUL,COND=(0,LT)
//STEPLIB  DD DSN=RR.CAS.EHMS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSERR   DD DSN=RR.CAS.EHMS.SYSERR(+1),DISP=SHR
//ENGMAS   DD DSN=RR.CAS.EHMS.ENGMAS(0),DISP=SHR
//TRNMAS   DD DSN=RR.CAS.EHMS.TRNMAS(0),DISP=SHR
//RULMAS   DD DSN=RR.CAS.EHMS.RULMAS(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(15,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=8000)
//SYSIN    DD DSN=RR.CAS.EHMS.CNTLLIB(EHMCTL),DISP=SHR
//*
//STEP060  EXEC PGM=MROPLN,COND=(0,LT)
//STEPLIB  DD DSN=RR.CAS.EHMS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=*
//SYSERR   DD DSN=RR.CAS.EHMS.SYSERR(+1),DISP=SHR
//ENGMAS   DD DSN=RR.CAS.EHMS.ENGMAS(0),DISP=SHR
//RULMAS   DD DSN=RR.CAS.EHMS.RULMAS(0),DISP=SHR
//SHPSLT   DD DSN=RR.CAS.EHMS.CNTLLIB(SHPSLT),DISP=SHR
//SVPLAN   DD DSN=RR.CAS.EHMS.SVPLAN(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(TRK,(10,5),RLSE),
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=8000)
//SYSIN    DD DSN=RR.CAS.EHMS.CNTLLIB(EHMCTL),DISP=SHR
//*
//STEP070  EXEC PGM=FLTRPT,COND=(0,LT)
//STEPLIB  DD DSN=RR.CAS.EHMS.LOADLIB,DISP=SHR
//SYSPRINT DD SYSOUT=A,DEST=DERBY.CONTROL
//SYSERR   DD DSN=RR.CAS.EHMS.SYSERR(+1),DISP=SHR
//ENGMAS   DD DSN=RR.CAS.EHMS.ENGMAS(0),DISP=SHR
//TRNMAS   DD DSN=RR.CAS.EHMS.TRNMAS(0),DISP=SHR
//ALRTMS   DD DSN=RR.CAS.EHMS.ALRTMS(0),DISP=SHR
//RULMAS   DD DSN=RR.CAS.EHMS.RULMAS(0),DISP=SHR
//SVPLAN   DD DSN=RR.CAS.EHMS.SVPLAN(0),DISP=SHR
//SYSIN    DD DSN=RR.CAS.EHMS.CNTLLIB(EHMCTL),DISP=SHR
//*
//
